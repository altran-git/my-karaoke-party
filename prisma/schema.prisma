// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_NON_POOLING")
}

model Video {
  id        String   @id
  title     String
  artist    String
  song      String
  coverUrl  String
  createdAt DateTime @default(now())
  duration  String
}

model Party {
  id                 Int       @id @default(autoincrement())
  hash               String?   @unique
  name               String
  createdAt          DateTime  @default(now())
  /// SHA-256 of the host's PIN (or, for parties created before PINs, of a
  /// generated host code). Proves the host when loading playlists or
  /// deleting. Null for parties created before either existed.
  hostKeyHash        String?
  /// Wrong host PINs in a row. Five lock PIN checks for a while (see
  /// hostLockedUntil), so a 4-digit PIN can't be guessed by trying them all.
  hostFailedAttempts Int       @default(0)
  hostLockedUntil    DateTime?

  @@index([hash])
}

/// A saved list of songs. Everyone can see, load, rename and delete any
/// playlist (deleting asks them to type DELETE).
model Playlist {
  id              Int            @id @default(autoincrement())
  /// Random, unguessable public id used in the link /playlists/<hash>.
  hash            String         @unique
  name            String
  /// Hash of the party the songs were saved from, if any.
  sourceParty     String?
  /// That party's hostKeyHash when the songs were saved. Its host can later
  /// overwrite the playlist from a party with the same code and PIN.
  hostKeyHash     String?
  createdAt       DateTime       @default(now())
  /// Last change to the name or songs. Loading the playlist doesn't count.
  updatedAt       DateTime       @updatedAt
  /// How many times it was loaded into a party, when, and into which one
  /// (party hash). Updated with raw SQL so updatedAt isn't touched.
  loadCount       Int            @default(0)
  lastLoadedAt    DateTime?
  lastLoadedParty String?
  songs           PlaylistSong[]
}

model PlaylistSong {
  id         Int      @id @default(autoincrement())
  playlistId Int
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  /// Order in the playlist, starting at 0.
  position   Int
  /// YouTube video id.
  videoId    String
  title      String
  coverUrl   String
  duration   String?

  @@index([playlistId, position])
}
