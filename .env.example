# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
DATABASE_URL="postgresql://postgres:password@localhost:5432/mykaraoke_party"
DATABASE_URL_NON_POOLING="postgresql://postgres:password@localhost:5432/mykaraoke_party"

# YouTube Data V3 API - https://developers.google.com/youtube/v3/getting-started
YOUTUBE_API_KEY=

# Realtime queue server (Cloudflare Worker in party/), including https://
# Printed by `pnpm deploy:pk`, e.g. https://my-karaoke-party.<you>.workers.dev
# For local development with `pnpm dev:pk` use http://localhost:8787
NEXT_PUBLIC_PARTYKIT_URL=

# Shared secret between this app and the realtime server (at least 32 chars).
# Must match PARTY_SECRET on the Cloudflare Worker (`npx wrangler secret put PARTY_SECRET`,
# or .dev.vars for `pnpm dev:pk`). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PARTY_SECRET=

# Public domain of the site, WITHOUT https:// (used for QR code / join links in production)
NEXT_PUBLIC_BASE_URL=

# Vercel KV / Upstash Redis - caches YouTube search results
# (set automatically on Vercel when you connect an Upstash KV store)
KV_REST_API_URL=
KV_REST_API_TOKEN=